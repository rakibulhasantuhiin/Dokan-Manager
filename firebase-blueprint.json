{
  "entities": {
    "ShopData": {
      "title": "ShopData",
      "description": "Consolidated high-efficiency store snapshot optimized for zero-quota exhaustion",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" },
        "settings": { "type": "object" },
        "products": { "type": "array" },
        "customers": { "type": "array" },
        "transactions": { "type": "array" },
        "sales": { "type": "array" },
        "expenses": { "type": "array" },
        "suppliers": { "type": "array" },
        "purchases": { "type": "array" },
        "cashEntries": { "type": "array" }
      },
      "required": ["userId", "updatedAt"]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Store configuration and preferences for a shop",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "hideOnboarding": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["shopName", "userId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record for khata and due ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "totalGiven": { "type": "number" },
        "totalReceived": { "type": "number" },
        "currentDue": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "userId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Customer due and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["due", "payment"] },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "note": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["customerId", "type", "amount", "userId"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "measurementType": { "type": "string", "maxLength": 30 },
        "unit": { "type": "string", "maxLength": 30 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "lowStockAlert": { "type": "number" },
        "barcode": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "purchasePrice", "sellingPrice", "userId"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed sales memo record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "memoNo": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "profit": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["memoNo", "grandTotal", "userId"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Shop expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 60 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["title", "amount", "userId"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier information and ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "company": { "type": "string", "maxLength": 100 },
        "totalDebt": { "type": "number" },
        "totalPaid": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "userId"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Goods purchase records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 100 },
        "itemsSummary": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "date": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["itemsSummary", "amount", "userId"]
    },
    "CashEntry": {
      "title": "CashEntry",
      "description": "Daily cash khata entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["in", "out"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 200 },
        "date": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["type", "amount", "description", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/shop/{documentId}": {
      "schema": "ShopData",
      "description": "Zero-quota-drain aggregated shop snapshot"
    },
    "/users/{userId}/settings/{settingsId}": {
      "schema": "ShopSettings",
      "description": "User specific shop settings"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "User customers list"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User customer transactions"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "User shop products"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "User sales records"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "User expense records"
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "User supplier records"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "User purchase records"
    },
    "/users/{userId}/cashEntries/{cashEntryId}": {
      "schema": "CashEntry",
      "description": "User cash book records"
    }
  }
}
